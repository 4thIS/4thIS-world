# 4thIS-world 서버 설정. `cp .env.example .env` 후 값을 채운다. .env는 커밋하지 않는다.

# 필수: 관리자 로그인 비밀번호
ADMIN_PASSWORD=

# 필수: 세션 쿠키 서명 키. 32자 이상 무작위 문자열
# 만들기: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# 아래는 선택. Docker 이미지에 기본값이 들어 있다.
# PORT=8080                       # 컨테이너 안 포트. compose를 쓰면 바꾸지 않는다
# DB_PATH=/data/world.db          # SQLite 파일 (볼륨 world-data)
# WEB_DIST=/app/apps/web/dist     # 웹 빌드 폴더 (정적 서빙)
# NODE_ENV=production             # production이면 쿠키에 Secure. HTTPS나 localhost가 아니면 development로
# TRUST_PROXY=1                   # nginx 같은 리버스 프록시 뒤라면 1 (X-Forwarded-For로 IP 확인)
